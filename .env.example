# Copy this file to .env - never commit the real .env file.

# Basic Auth for the existing demo page (change these)
SITE_USERNAME=admin
SITE_PASSWORD=change-me

# Database (runs as its own Docker container - see docker-compose.yml)
DB_HOST=db
DB_NAME=db1
DB_USER=dbuser
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
WEB_PORT=8080

# Internal FastAPI service; do not publish this URL outside the Compose network.
CATALOG_API_URL=http://catalog-api:8000

# Configure an LLM provider in a later phase; keep secrets in the local .env only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
