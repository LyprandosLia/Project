# Copy this file to .env - never commit the real .env file.

# Basic Auth for the web page (change these)
SITE_USERNAME=admin
SITE_PASSWORD=pass

# Database (runs as its own Docker container - see docker-compose.yml)
DB_HOST=db
DB_NAME=db1
DB_USER=dbuser
DB_PASSWORD=dbpass
DB_ROOT_PASSWORD=dbrootpass
